# Copy to .env.local for local development. Netlify holds the same two values
# as site environment variables (Site configuration -> Environment variables).
#
# Both are safe to expose in a browser bundle: the anon key grants no data
# access on its own. Row Level Security means only a signed-in, invited user
# reads or writes anything.
VITE_SUPABASE_URL=https://kkcvkvamwkjaruldypys.supabase.co
VITE_SUPABASE_ANON_KEY=your-project-anon-key
